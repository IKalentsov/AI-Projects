# =============================================================================
# .dockerignore — что не попадает в контекст сборки образов.
# Контекст сборки — корень репозитория (см. docker/compose/compose.app.yaml),
# поэтому правила применяются ко всему дереву.
# Цель: меньше контекст — быстрее сборка и стабильнее кэш слоёв.
# =============================================================================

# --- Система контроля версий и IDE ------------------------------------------
.git
.gitignore
.gitattributes
.gitlab-ci.yml
.vs
.vscode
.idea
*.user
*.suo
*.DotSettings.user

# --- Секреты и локальные данные (никогда не в образ!) -----------------------
.env
.env.*
!.env.example
**/*.pfx
**/*.snk

# --- Артефакты сборки .NET ---------------------------------------------------
**/bin/
**/obj/
**/TestResults/
**/coverage*.xml
**/coverage*.json
**/*.binlog
**/*.trx
backend/publish/

# --- Node / фронтенд ---------------------------------------------------------
**/node_modules/
**/dist/
**/build/
**/.vite/
**/coverage/
**/playwright-report/
**/test-results/
**/.turbo/
**/*.tsbuildinfo

# --- Документация и артефакты работы агента ---------------------------------
# (в образ не нужны: увеличивают контекст, инвалидируют кэш)
docs/
ai-tasks/
.dsh/
*.md
!backend/**/*.md
!frontend/**/*.md

# --- Прочее ------------------------------------------------------------------
**/.DS_Store
**/Thumbs.db
**/*.log
**/*.tmp
docker-data/
