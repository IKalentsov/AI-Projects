# =============================================================================
# MarketSniperMVP — переменные окружения (ШАБЛОН)
#
# Скопировать в .env и заполнить:  cp .env.example .env
# Файл .env НЕ коммитится (см. .gitignore). Секретов в git быть не должно.
# =============================================================================

# --- Общее ------------------------------------------------------------------
# Окружение: Development | Staging | Production
APP_ENV=Development
# Часовой пояс контейнеров (важно для корректных timestamps)
TZ=Europe/Moscow

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Порт на хосте (5435, чтобы не конфликтовать с DirectoryService — у него 5434)
POSTGRES_HOST_PORT=5435
POSTGRES_DB=marketsniper_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres

# --- Redis ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=change_me_redis

# --- Backend (.NET) ---------------------------------------------------------
BACKEND_HOST_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# Строка подключения собирается из переменных выше; здесь — только если нужен полный контроль
ConnectionStrings__Default=Host=postgres;Port=5432;Database=marketsniper_db;Username=postgres;Password=change_me_postgres
ConnectionStrings__Redis=redis:6379,password=change_me_redis,abortConnect=false

# --- Frontend ---------------------------------------------------------------
FRONTEND_HOST_PORT=5173
# Базовый URL API для браузера (Vite-переменные вкомпилируются в бандл на этапе сборки)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Reverse-proxy ----------------------------------------------------------
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# --- Наблюдаемость ----------------------------------------------------------
# Aspire Dashboard (MIT): логи + трейсы + метрики по OTLP. Основной инструмент dev.
ASPIRE_UI_PORT=18888
ASPIRE_OTLP_PORT=18889

# Seq (опционально): лицензия проприетарная, бесплатен только тариф Individual.
SEQ_UI_PORT=8081
SEQ_HOST_PORT=5341
SEQ_ADMIN_USERNAME=admin
SEQ_ADMIN_PASSWORD=change_me_seq

# --- Инструменты (профиль tools) -------------------------------------------
PGADMIN_HOST_PORT=8082
PGADMIN_DEFAULT_EMAIL=admin@marketsniper.local
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin

# --- SonarQube (профиль sonar, локальный статанализ) ------------------------
SONAR_HOST_PORT=9000
SONAR_DB_NAME=sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=change_me_sonar
# Токен создаётся в UI SonarQube после первого запуска
SONAR_TOKEN=

# --- Внешние API маркетплейсов (заполняются по мере интеграции) -------------
# Ключи НЕ коммитить. В dev можно оставить пустыми — используются фикстуры.
MARKETPLACE_OZON_CLIENT_ID=
MARKETPLACE_OZON_API_KEY=
MARKETPLACE_WILDBERRIES_API_KEY=
MARKETPLACE_YANDEX_API_KEY=
