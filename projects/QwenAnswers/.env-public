# Скопируйте этот файл в .env и заполните своими данными.
# Файл .env НЕ попадает в git — он для локального использования.

# ── Обязательные параметры ──────────────────────────────────────────────────

# API-ключ. Если ваш сервер не требует ключ — впишите любое значение, например ollama.
AI_API_KEY=

# URL AI-сервера вместе с путём к /v1. Обязательно с http:// или https://.
AI_ENDPOINT=

# Имя модели, которая запущена на сервере.
AI_MODEL_NAME=

# ── Опциональные параметры (если не указаны — берутся значения ниже) ────────

# Сколько последних реплик диалога держать в контексте.
# AI_MAX_HISTORY_MESSAGES=50

# Таймаут одного запроса к модели, в секундах.
# AI_REQUEST_TIMEOUT_SECONDS=300

# ── Тесты ───────────────────────────────────────────────────────────────────

# Раскомментируйте, чтобы гонять живые тесты против реально запущенной модели.
# AI_RUN_LIVE_TESTS=1
